rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Special guest roster table - managed directly from database
    match /special_guest_roster/{guestId} {
      allow read, write: if true;
    }

    // Wedding wishes guestbook
    match /wedding_wishes/{wishId} {
      allow read, write: if true;
    }

    // Wedding RSVPs table
    match /wedding_rsvps/{rsvpId} {
      allow read, write: if true;
    }

    // Player adventure progress table
    match /player_progress/{playerId} {
      allow read, write: if true;
    }

    // Wedding keepsakes catalog table
    match /wedding_keepsakes/{keepsakeId} {
      allow read, write: if true;
    }

    // Wedding couple trivia quizzes table
    match /wedding_quizzes/{quizId} {
      allow read, write: if true;
    }

    // Wedding timeline and schedule table
    match /wedding_timeline/{eventId} {
      allow read, write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
